{
  "url": "https://outlook.cloud.microsoft/mail/",
  "domains": ["*.outlook.cloud.microsoft", "outlook.cloud.microsoft", "substrate.office.com"],
  "captureMode": "filtered",
  "captureFilters": {
    "match": ["owa/service\\.svc", "searchservice"],
    "skip": ["telemetry", "sessiondata", "pimg"]
  },
  "captureVars": [
    {
      "name": "inboxFolderId",
      "description": "Concrete Exchange BaseFolderId for the inbox, replacing the DistinguishedFolderId alias.",
      "urlMatch": "action=FindConversation",
      "jq": ".requestBody | objects | .Body.ParentFolderId.BaseFolderId? | objects | select(.__type != \"DistinguishedFolderId:#Exchange\") | .Id | strings"
    },
    {
      "name": "anchorMailbox",
      "description": "x-anchormailbox routing header value (PUID or SMTP form) for this mailbox.",
      "urlMatch": "owa/service\\.svc",
      "jq": ".requestHeaders[\"x-anchormailbox\"]? | strings"
    }
  ],
  "wiggle": "wiggle.js",
  "seed": "owa"
}
