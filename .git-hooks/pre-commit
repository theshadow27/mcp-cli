#!/usr/bin/env bash
# Pre-commit hook: the static gate — skips checks for non-code changes.
#
# Tiers:
#   docs-only  (.md, .claude/ docs)           → skip all checks
#   config-only (package.json, *.json config) → static gate
#   source changes                            → static gate
#
# A commit runs NO tests (#3344). The ladder is pre-commit → static only;
# pre-push → static + diff-aware tests; CI → full suite + coverage ratchet.

set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"

# Sprint-active guard (#1425, #1443) — reject commits to main's checkout
# while a sprint is active. Worktree commits and overrides are allowed.
# shellcheck source=sprint-active.sh
source "$HOOK_DIR/sprint-active.sh"
sprint_active_check || exit 1

# Get list of staged files (excludes deleted files)
staged_files=$(git diff --cached --name-only --diff-filter=d)

if [ -z "$staged_files" ]; then
  echo "No staged files, skipping checks."
  exit 0
fi

# Privacy: block staging of the local username in added/changed lines.
# Catches raw (/Users/<user>/ or /home/<user>/) and Claude-slug forms
# (-Users-<user>- where dots in usernames become dashes).
if [ -z "${SKIP_PRIVACY_CHECK:-}" ]; then
  user_raw="$USER"
  user_slug="${user_raw//./-}"
  privacy_pattern="(/Users/${user_raw}/|/home/${user_raw}/|-Users-${user_slug}-)"
  # Grep added lines only (not context, not removed). -U disables newline
  # normalization so we can reliably match within single diff lines.
  privacy_hits=$(git diff --cached -U0 --no-color -- $staged_files \
    | grep '^+' | grep -E "$privacy_pattern" || true)
  if [ -n "$privacy_hits" ]; then
    echo "pre-commit: refusing to stage lines containing local home paths" >&2
    echo "pattern: $privacy_pattern" >&2
    echo "$privacy_hits" | head -20 >&2
    echo >&2
    echo "Redact the paths (use ~/ or <repo-root> or a generic placeholder)." >&2
    echo "If you are certain this is intentional, bypass with:" >&2
    echo "  SKIP_PRIVACY_CHECK=1 git commit ..." >&2
    exit 1
  fi
fi

# Secret/PII sanitizer gate: reject staged additions to recordings/ or
# agent-grid/binaries/ that contain secret-shaped content. Fail-closed:
# any scanner error is treated as a match (safe default).
recording_files=$(echo "$staged_files" | grep -E '^(recordings/|agent-grid/binaries/)' || true)
if [ -n "$recording_files" ]; then
  # Fail-closed on binary files: git diff --numstat shows "-\t-\t<path>" for
  # binaries. These can't be text-scanned so they must be blocked outright
  # (raw binaries should go through LFS; only LFS pointer files are text).
  # shellcheck disable=SC2086
  binary_numstat=$(git diff --cached --numstat -- $recording_files) || {
    echo "pre-commit: git diff --numstat failed (fail-closed)" >&2
    exit 1
  }
  binary_files=$(printf '%s\n' "$binary_numstat" \
    | awk '$1 == "-" && $2 == "-" { print $3 }') || {
    echo "pre-commit: binary detection failed (fail-closed)" >&2
    exit 1
  }
  if [ -n "$binary_files" ]; then
    echo "pre-commit: staged binary files in recordings/ or binaries/ cannot be scanned for secrets" >&2
    printf '%s\n' "$binary_files" | head -10 >&2
    echo "Use LFS for binary content, or run the sanitizer on text equivalents." >&2
    exit 1
  fi

  # Extract added text lines from diff. Filter out only the "+++ b/..."
  # file-header lines (3 plusses), keeping real content that starts with "+".
  # shellcheck disable=SC2086
  diff_output=$(git diff --cached -U0 --no-color -- $recording_files) || {
    echo "pre-commit: git diff failed (fail-closed)" >&2
    exit 1
  }
  added_content=$(printf '%s\n' "$diff_output" \
    | grep '^+' | grep -v '^+++' | sed 's/^+//') || {
    rc=$?
    if [ "$rc" -gt 1 ]; then
      echo "pre-commit: content extraction failed (fail-closed)" >&2
      exit 1
    fi
  }
  if [ -n "$added_content" ]; then
    HOOK_DIR_ABS="$(cd "$HOOK_DIR/.." && pwd)"
    if ! printf '%s\n' "$added_content" | bun run "$HOOK_DIR_ABS/scripts/scan-secrets.ts"; then
      echo "pre-commit: refusing to stage files with unsanitized secrets in recordings/ or binaries/" >&2
      echo "Run the sanitizer on the files before committing." >&2
      exit 1
    fi
  fi
fi

# Classify staged files into tiers
# shellcheck source=classify.sh
source "$HOOK_DIR/classify.sh"
classify_files <<< "$staged_files"

# The static gate is a single command, `am-i-done --pre-commit` (the am-i-done package), which
# runs bun-version, typecheck, lint (check only), the doing-it-wrong rules, agent-grid and
# phase-lock. CI runs the same gate, so local and CI share one static definition of done (#2344).
# The package script installs dependencies first (`bun install --frozen-lockfile`), so a fresh
# checkout or a lockfile change needs nothing extra here.
#
# Tests and the coverage ratchet deliberately do NOT run here (#3344): pre-push runs the
# diff-aware subset under the host-wide gate lease (#2690), and CI runs the full suite plus
# coverage, on clean runners, which is the arbiter.
if $has_source; then
  echo "Running pre-commit checks (source changes detected)..."

  echo "  am-i-done (static gate: typecheck, lint, rules)..."
  bun run am-i-done --pre-commit

  echo "Static checks passed (tests run at pre-push; coverage in CI)."
elif $has_config; then
  echo "Running pre-commit checks (config-only changes, skipping tests)..."

  echo "  am-i-done (static gate: typecheck, lint, rules)..."
  bun run am-i-done --pre-commit

  echo "Config checks passed (tests skipped)."
else
  echo "Docs-only changes detected, skipping all checks."
fi
